{
	"name": "agent-ui",
	"version": "0.1.0",
	"type": "module",
	"description": "Self-hosted web workbench for coding agents: streaming chat, Monaco editor, file tree, git diff and a real PTY terminal.",
	"license": "MIT",
	"author": "xingcheng1061",
	"homepage": "https://github.com/xingcheng1061/agent-ui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xingcheng1061/agent-ui.git"
	},
	"bugs": {
		"url": "https://github.com/xingcheng1061/agent-ui/issues"
	},
	"keywords": [
		"coding-agent",
		"claude",
		"web-ui",
		"monaco",
		"terminal",
		"pty",
		"self-hosted"
	],
	"engines": {
		"node": ">=20.19"
	},
	"bin": {
		"agent-ui": "dist/server/cli.js"
	},
	"files": [
		"dist/server",
		"dist/web",
		"docs",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "tsx watch server/index.ts",
		"dev:web": "vite",
		"build": "npm run typecheck && npm run build:server && npm run build:web",
		"build:server": "node scripts/build-server.mjs",
		"build:web": "vite build",
		"start": "node dist/server/index.js",
		"start:source": "tsx server/index.ts",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
		"prepack": "npm run build"
	},
	"dependencies": {
		"cordis": "^3.18.1",
		"express": "^5.1.0",
		"node-pty": "^1.0.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@streamdown/math": "^1.0.3",
		"@streamdown/mermaid": "^1.0.3",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.2",
		"@types/react": "^18.3.17",
		"@types/react-dom": "^18.3.5",
		"@types/ws": "^8.5.13",
		"@vitejs/plugin-react": "^4.3.4",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/xterm": "^5.5.0",
		"concurrently": "^9.1.0",
		"katex": "^0.19.0",
		"monaco-editor": "^0.52.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"shiki": "^4.5.0",
		"streamdown": "^2.7.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vite": "^6.0.5"
	}
}
